# Copy this file to ".env" and fill in your own values. Never share your real .env.

# A long random secret used to sign login sessions. Change this!
JWT_SECRET=change-me-to-a-long-random-secret

# The username that becomes the Founder/Admin when it signs up (default: bludhound420)
FOUNDER_USERNAME=bludhound420

# Folder where the database file and uploaded pictures are stored.
# On Render this must point at your Persistent Disk mount (e.g. /var/data)
DATA_DIR=./data

# Port the server listens on. Render sets this automatically.
PORT=3000
